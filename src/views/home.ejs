<!-- Hero Banners Section -->
<div class="container hero-wrapper">
    <div class="hero-grid">
        <a href="/products" class="banner-card main-banner">
            <div class="banner-content main-banner-content">
                <h2 class="main-banner-title">GEARSTATION MEGA SALE</h2>
                <p class="main-banner-desc">Giảm giá lên đến 50% cho PC & Linh kiện</p>
                <span class="btn btn-primary banner-btn">Mua ngay <i class='bx bx-chevron-right'></i></span>
            </div>
        </a>
        <div class="side-banners">
            <a href="#" class="banner-card side-banner">
                <div class="banner-content side-banner-content bg-red-gradient">
                    <h3 class="side-banner-title">LAPTOP GAMING<br>MỚI NHẤT</h3>
                </div>
            </a>
            <a href="#" class="banner-card side-banner">
                <div class="banner-content side-banner-content bg-blue-gradient">
                    <h3 class="side-banner-title">BUILD PC<br>NHẬN QUÀ KHỦNG</h3>
                </div>
            </a>
        </div>
    </div>
</div>

<!-- Categories Section -->
<div class="container">
    <section id="categories">
        <div class="section-container">
            <div class="section-header">
                <h2 class="section-title">Danh mục nổi bật</h2>
            </div>
            <div class="category-grid">
                <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                    <% categories.forEach((cat, index) => { %>
                    <a href="/products/category/<%= cat.slug %>" class="category-card">
                        <div class="category-icon">
                            <% if(cat.slug.includes('cpu')) { %><i class='bx bx-chip'></i>
                            <% } else if(cat.slug.includes('vga') || cat.slug.includes('card')) { %><i class='bx bx-credit-card-front'></i>
                            <% } else if(cat.slug.includes('main')) { %><i class='bx bx-server'></i>
                            <% } else if(cat.slug.includes('ram')) { %><i class='bx bx-memory-card'></i>
                            <% } else if(cat.slug.includes('mouse') || cat.slug.includes('chuot')) { %><i class='bx bx-mouse'></i>
                            <% } else if(cat.slug.includes('keyboard') || cat.slug.includes('ban-phim')) { %><i class='bx bxs-keyboard'></i>
                            <% } else { %><i class='bx bx-laptop'></i><% } %>
                        </div>
                        <h3><%= cat.name %></h3>
                    </a>
                    <% }) %>
                <% } else { %>
                    <a href="#" class="category-card"><div class="category-icon"><i class='bx bx-chip'></i></div><h3>CPU</h3></a>
                    <a href="#" class="category-card"><div class="category-icon"><i class='bx bx-credit-card-front'></i></div><h3>VGA</h3></a>
                    <a href="#" class="category-card"><div class="category-icon"><i class='bx bx-server'></i></div><h3>Mainboard</h3></a>
                    <a href="#" class="category-card"><div class="category-icon"><i class='bx bx-memory-card'></i></div><h3>RAM</h3></a>
                    <a href="#" class="category-card"><div class="category-icon"><i class='bx bx-hdd'></i></div><h3>Ổ cứng</h3></a>
                    <a href="#" class="category-card"><div class="category-icon"><i class='bx bx-desktop'></i></div><h3>Màn hình</h3></a>
                    <a href="#" class="category-card"><div class="category-icon"><i class='bx bxs-keyboard'></i></div><h3>Bàn phím</h3></a>
                    <a href="#" class="category-card"><div class="category-icon"><i class='bx bx-mouse'></i></div><h3>Chuột</h3></a>
                <% } %>
            </div>
        </div>
    </section>
</div>

<!-- Featured Products -->
<div class="container">
    <section>
        <div class="section-container">
            <div class="section-header">
                <h2 class="section-title">Sản phẩm bán chạy <i class='bx bxs-hot text-primary'></i></h2>
                <a href="/products?featured=true" class="view-all">Xem tất cả</a>
            </div>
            <div class="product-grid">
                <% if (typeof featuredProducts !== 'undefined' && featuredProducts.length > 0) { %>
                    <% featuredProducts.forEach(product => { %>
                    <div class="product-card">
                        <% if (product.is_featured) { %><div class="product-badge">HOT</div><% } %>
                        <a href="/products/<%= product.slug %>" class="product-img-wrap">
                            <% if (product.image) { %>
                                <img src="<%= product.image %>" alt="<%= product.name %>" style="width: 100%; height: 100%; object-fit: cover; position: absolute; top:0; left:0;">
                            <% } else { %>
                                <div class="product-img-placeholder"><i class='bx bx-image-alt'></i></div>
                            <% } %>
                        </a>
                        <div class="product-info">
                            <h3><a href="/products/<%= product.slug %>" title="<%= product.name %>"><%= product.name %></a></h3>
                            <div class="product-price-box">
                                <% if (product.sale_price) { %>
                                    <span class="price"><%= product.sale_price.toLocaleString('vi-VN') %> ₫</span>
                                    <span class="price-old"><%= product.price.toLocaleString('vi-VN') %> ₫</span>
                                <% } else { %>
                                    <span class="price"><%= product.price ? product.price.toLocaleString('vi-VN') + ' ₫' : 'Liên hệ' %></span>
                                <% } %>
                            </div>
                            <form action="/cart/add" method="POST" class="add-to-cart-form" style="margin:0;">
                                <input type="hidden" name="productId" value="<%= product.id %>">
                                <input type="hidden" name="quantity" value="1">
                                <button type="submit" class="btn-buy-now"><i class='bx bx-cart'></i> Thêm vào giỏ</button>
                            </form>
                        </div>
                    </div>
                    <% }) %>
                <% } else { %>
                    <p style="color: var(--text-muted);">Đang cập nhật sản phẩm...</p>
                <% } %>
            </div>
        </div>
    </section>
</div>

