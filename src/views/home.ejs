<div class="container hero-wrapper">
    <div class="hero-showcase">
        <a href="/products?featured=true" class="hero-feature">
            <div class="hero-copy">
                <span class="hero-kicker"><i class='bx bxs-zap'></i> GearStation Mega Sale</span>
                <h1>Build PC chiến game, săn deal cực chất</h1>
                <p>Giảm đến 50% cho VGA, laptop gaming, màn hình và combo nâng cấp hiệu năng.</p>
                <div class="hero-actions">
                    <span class="btn btn-primary hero-cta">Mua ngay <i class='bx bx-chevron-right'></i></span>
                    <span class="hero-note">Freeship đơn từ <%= typeof formatCurrency === 'function' ? formatCurrency(2000000) : '2.000.000 ₫' %></span>
                </div>
            </div>

            <div class="hero-product" aria-hidden="true">
                <img src="/img/products/vga-colorful-igame-rtx-4090-24gb.jpg" alt="">
                <span class="hero-price-tag">RTX 4090<br><strong>-12%</strong></span>
                <span class="hero-chip-tag">24GB GDDR6X</span>
            </div>
        </a>

        <div class="hero-side">
            <a href="/products/search?q=laptop" class="hero-tile hero-tile-laptop">
                <span class="tile-label">Laptop Gaming</span>
                <strong>Mẫu mới 2026</strong>
                <small>RTX series, màn 144Hz+</small>
            </a>

            <a href="/products/category/man-hinh" class="hero-tile hero-tile-monitor">
                <span class="tile-label">Màn hình</span>
                <strong>Nâng cấp góc chơi</strong>
                <small>2K, IPS, tần số quét cao</small>
            </a>

            <a href="/products" class="hero-tile hero-tile-service">
                <span class="tile-label">Combo Build PC</span>
                <strong>Tư vấn cấu hình</strong>
                <small>Chọn linh kiện đúng nhu cầu</small>
            </a>
        </div>
    </div>

    <div class="hero-promo-strip">
        <a href="/products/category/cpu-bo-vi-xu-ly" class="promo-pill">
            <i class='bx bx-chip'></i>
            <span><strong>CPU hot</strong><small>Hiệu năng cao</small></span>
        </a>
        <a href="/products/category/vga-card-do-hoa" class="promo-pill">
            <i class='bx bx-credit-card-front'></i>
            <span><strong>VGA sale</strong><small>Giá tốt hôm nay</small></span>
        </a>
        <a href="/products/category/ban-phim-chuot" class="promo-pill">
            <i class='bx bxs-keyboard'></i>
            <span><strong>Gear RGB</strong><small>Đủ phím, chuột</small></span>
        </a>
        <a href="/products/category/ssd-hdd-o-cung" class="promo-pill">
            <i class='bx bx-hdd'></i>
            <span><strong>SSD tốc độ</strong><small>Nâng cấp nhanh</small></span>
        </a>
    </div>
</div>

<div class="container">
    <section id="categories">
        <div class="section-container">
            <div class="section-header">
                <h2 class="section-title">Danh mục nổi bật</h2>
            </div>
            <div class="category-grid">
                <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                    <% categories.forEach(cat => { %>
                    <a href="/products/category/<%= cat.slug %>" class="category-card">
                        <div class="category-icon">
                            <% if(cat.slug.includes('cpu')) { %><i class='bx bx-chip'></i>
                            <% } else if(cat.slug.includes('vga') || cat.slug.includes('card')) { %><i class='bx bx-credit-card-front'></i>
                            <% } else if(cat.slug.includes('main')) { %><i class='bx bx-server'></i>
                            <% } else if(cat.slug.includes('ram')) { %><i class='bx bx-memory-card'></i>
                            <% } else if(cat.slug.includes('mouse') || cat.slug.includes('chuot')) { %><i class='bx bx-mouse'></i>
                            <% } else if(cat.slug.includes('keyboard') || cat.slug.includes('ban-phim')) { %><i class='bx bxs-keyboard'></i>
                            <% } else { %><i class='bx bx-laptop'></i><% } %>
                        </div>
                        <h3><%= cat.name %></h3>
                    </a>
                    <% }) %>
                <% } else { %>
                    <a href="#" class="category-card"><div class="category-icon"><i class='bx bx-chip'></i></div><h3>CPU</h3></a>
                    <a href="#" class="category-card"><div class="category-icon"><i class='bx bx-credit-card-front'></i></div><h3>VGA</h3></a>
                    <a href="#" class="category-card"><div class="category-icon"><i class='bx bx-server'></i></div><h3>Mainboard</h3></a>
                    <a href="#" class="category-card"><div class="category-icon"><i class='bx bx-memory-card'></i></div><h3>RAM</h3></a>
                    <a href="#" class="category-card"><div class="category-icon"><i class='bx bx-hdd'></i></div><h3>Ổ cứng</h3></a>
                    <a href="#" class="category-card"><div class="category-icon"><i class='bx bx-desktop'></i></div><h3>Màn hình</h3></a>
                    <a href="#" class="category-card"><div class="category-icon"><i class='bx bxs-keyboard'></i></div><h3>Bàn phím</h3></a>
                    <a href="#" class="category-card"><div class="category-icon"><i class='bx bx-mouse'></i></div><h3>Chuột</h3></a>
                <% } %>
            </div>
        </div>
    </section>
</div>

<%- include('partials/product-section', {
    sectionTitle: 'Sản phẩm bán chạy',
    sectionIcon: 'bxs-hot',
    sectionLink: '/products?featured=true',
    products: featuredProducts
}) %>

<%- include('partials/product-section', {
    sectionTitle: 'Sản phẩm mới',
    sectionIcon: 'bx-star',
    sectionLink: '/products',
    products: latestProducts
}) %>
