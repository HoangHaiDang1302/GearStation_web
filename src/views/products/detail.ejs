<div class="breadcrumb">
    <div class="container">
        <a href="/">Trang chủ</a>
        <i class='bx bx-chevron-right'></i>
        <a href="/products">Sản phẩm</a>
        <i class='bx bx-chevron-right'></i>
        <span><%= product.name %></span>
    </div>
</div>

<div class="container">
    <div class="product-detail-wrapper">
        <!-- Cột Ảnh -->
        <div class="product-detail-image">
            <div class="main-image">
                <% if (product.image) { %>
                    <img src="<%= product.image %>" alt="<%= product.name %>">
                <% } else { %>
                    <div class="placeholder-img"><i class='bx bx-image'></i></div>
                <% } %>
            </div>
        </div>

        <!-- Cột Thông Tin -->
        <div class="product-detail-info">
            <h1 class="product-detail-title"><%= product.name %></h1>
            
            <div class="product-meta">
                <span class="meta-item">SKU: <strong>#GS<%= product.id.toString().padStart(5, '0') %></strong></span>
                <span class="meta-item">Tình trạng: <strong class="text-success">Còn hàng</strong></span>
            </div>

            <div class="product-detail-price">
                <% if (product.sale_price) { %>
                    <span class="current-price"><%= product.sale_price.toLocaleString('vi-VN') %> ₫</span>
                    <span class="old-price"><%= product.price.toLocaleString('vi-VN') %> ₫</span>
                    <span class="discount-badge">-<%= Math.round((product.price - product.sale_price)/product.price*100) %>%</span>
                <% } else { %>
                    <span class="current-price"><%= product.price ? product.price.toLocaleString('vi-VN') + ' ₫' : 'Liên hệ' %></span>
                <% } %>
            </div>

            <div class="product-features">
                <h3>Đặc điểm nổi bật:</h3>
                <ul>
                    <li><i class='bx bx-check text-primary'></i> Cam kết 100% chính hãng</li>
                    <li><i class='bx bx-check text-primary'></i> Bảo hành chính hãng 36 tháng</li>
                    <li><i class='bx bx-check text-primary'></i> Hỗ trợ đổi mới trong 7 ngày đầu</li>
                    <li><i class='bx bx-check text-primary'></i> Miễn phí giao hàng toàn quốc</li>
                </ul>
            </div>

            <form action="/cart/add" method="POST" class="add-to-cart-form">
                <input type="hidden" name="productId" value="<%= product.id %>">
                
                <div class="quantity-selector">
                    <button type="button" class="qty-btn" onclick="if(this.nextElementSibling.value > 1) this.nextElementSibling.value--;">-</button>
                    <input type="number" name="quantity" value="1" min="1" max="10" readonly>
                    <button type="button" class="qty-btn" onclick="if(this.previousElementSibling.value < 10) this.previousElementSibling.value++;">+</button>
                </div>

                <div class="action-buttons">
                    <button type="submit" class="btn btn-primary btn-add-cart">
                        <i class='bx bx-cart-add'></i> Mua Ngay
                    </button>
                    <button type="button" class="btn btn-outline btn-installment">
                        Trả góp 0% qua thẻ
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Cột Mô Tả -->
    <div class="product-description-section">
        <h2 class="section-title">Mô tả sản phẩm</h2>
        <div class="description-content">
            <p><%= product.description %></p>
            <p>GearStation tự hào là nhà phân phối thiết bị linh kiện PC chính hãng lớn nhất. Sản phẩm <strong><%= product.name %></strong> được phân phối với giá tốt nhất thị trường kèm dịch vụ chăm sóc khách hàng tiêu chuẩn 5 sao.</p>
        </div>
    </div>

    <!-- Sản phẩm liên quan -->
    <% if (relatedProducts && relatedProducts.length > 0) { %>
    <section class="related-products">
        <div class="section-header">
            <h2 class="section-title">Sản phẩm tương tự</h2>
        </div>
        <div class="product-grid">
            <% relatedProducts.forEach(p => { %>
                <div class="product-card">
                    <% if (p.is_featured) { %><div class="product-badge">HOT</div><% } %>
                    <a href="/products/<%= p.slug %>" class="product-img-wrap">
                        <% if (p.image) { %>
                            <img src="<%= p.image %>" alt="<%= p.name %>" style="width: 100%; height: 100%; object-fit: cover; position: absolute; top:0; left:0;">
                        <% } else { %>
                            <div class="product-img-placeholder"><i class='bx bx-image-alt'></i></div>
                        <% } %>
                    </a>
                    <div class="product-info">
                        <h3><a href="/products/<%= p.slug %>" title="<%= p.name %>"><%= p.name %></a></h3>
                        <div class="product-price-box">
                            <% if (p.sale_price) { %>
                                <span class="price"><%= p.sale_price.toLocaleString('vi-VN') %> ₫</span>
                                <span class="price-old"><%= p.price.toLocaleString('vi-VN') %> ₫</span>
                            <% } else { %>
                                <span class="price"><%= p.price ? p.price.toLocaleString('vi-VN') + ' ₫' : 'Liên hệ' %></span>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </section>
    <% } %>
</div>
