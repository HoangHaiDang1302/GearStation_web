<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Admin - GearStation' %></title>
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css?v=1.2">
    <style>
        /* ========== Admin Layout ========== */
        body { font-family: 'Inter', sans-serif; background: #0f1117; color: #e0e0e0; margin: 0; }
        .admin-layout { display: flex; min-height: 100vh; }

        /* Sidebar */
        .admin-sidebar {
            width: 260px; background: #1a1d27; border-right: 1px solid rgba(255,255,255,0.06);
            position: fixed; top: 0; left: 0; bottom: 0; z-index: 100;
            display: flex; flex-direction: column; transition: transform 0.3s;
        }
        .admin-sidebar-header {
            padding: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.06);
            display: flex; align-items: center; gap: 0.75rem;
        }
        .admin-sidebar-header i { font-size: 1.8rem; color: #e53e3e; }
        .admin-sidebar-header h2 { font-size: 1.2rem; margin: 0; color: #fff; font-weight: 700; }
        .admin-sidebar-header span { font-size: 0.75rem; color: #888; display: block; }
        
        .admin-nav { flex: 1; padding: 1rem 0; overflow-y: auto; }
        .admin-nav-section { padding: 0.5rem 1.5rem; font-size: 0.7rem; text-transform: uppercase; 
                              letter-spacing: 1px; color: #555; margin-top: 0.5rem; }
        .admin-nav a {
            display: flex; align-items: center; gap: 0.75rem;
            padding: 0.75rem 1.5rem; color: #999; text-decoration: none;
            font-size: 0.9rem; transition: all 0.2s; border-left: 3px solid transparent;
        }
        .admin-nav a:hover, .admin-nav a.active {
            color: #fff; background: rgba(229, 62, 62, 0.08); border-left-color: #e53e3e;
        }
        .admin-nav a i { font-size: 1.2rem; width: 24px; text-align: center; }

        .admin-sidebar-footer {
            padding: 1rem 1.5rem; border-top: 1px solid rgba(255,255,255,0.06);
            font-size: 0.85rem;
        }
        .admin-sidebar-footer a { color: #999; text-decoration: none; display: flex; align-items: center; gap: 0.5rem; }
        .admin-sidebar-footer a:hover { color: #e53e3e; }

        /* Main content */
        .admin-main { flex: 1; margin-left: 260px; padding: 2rem; }
        .admin-topbar {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,0.06);
        }
        .admin-topbar .user-info { display: flex; align-items: center; gap: 0.75rem; color: #999; }
        .admin-topbar .user-info strong { color: #fff; }

        /* Dashboard Stats */
        .dashboard-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; margin-bottom: 2rem; }
        .stat-card {
            background: #1a1d27; border: 1px solid rgba(255,255,255,0.06); border-radius: 12px;
            padding: 1.5rem; display: flex; align-items: center; gap: 1rem;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0,0,0,0.3); }
        .stat-icon {
            width: 56px; height: 56px; border-radius: 12px; display: flex;
            align-items: center; justify-content: center; font-size: 1.5rem;
        }
        .stat-icon.bg-primary { background: rgba(229,62,62,0.15); color: #e53e3e; }
        .stat-icon.bg-success { background: rgba(72,187,120,0.15); color: #48bb78; }
        .stat-icon.bg-warning { background: rgba(237,137,54,0.15); color: #ed8936; }
        .stat-icon.bg-danger { background: rgba(245,101,101,0.15); color: #f56565; }
        .stat-info h3 { font-size: 1.8rem; margin: 0; color: #fff; font-weight: 700; }
        .stat-info p { margin: 0; color: #888; font-size: 0.85rem; }

        /* Quick Links */
        .dashboard-quick-links h2 { color: #fff; margin-bottom: 1rem; }
        .quick-links-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; }
        .quick-link-card {
            background: #1a1d27; border: 1px solid rgba(255,255,255,0.06); border-radius: 12px;
            padding: 1.5rem; text-align: center; text-decoration: none; color: #ccc;
            transition: all 0.2s;
        }
        .quick-link-card:hover { background: #22252f; color: #e53e3e; transform: translateY(-2px); }
        .quick-link-card i { font-size: 2rem; display: block; margin-bottom: 0.5rem; }

        /* Admin Header Bar */
        .admin-header-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
        .admin-header-bar h1 { font-size: 1.5rem; color: #fff; margin: 0; display: flex; align-items: center; gap: 0.5rem; }

        /* Data Table */
        .admin-table-wrap { overflow-x: auto; }
        .admin-table {
            width: 100%; border-collapse: collapse; background: #1a1d27;
            border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; overflow: hidden;
        }
        .admin-table th {
            background: #22252f; padding: 0.75rem 1rem; text-align: left;
            font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; color: #888;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }
        .admin-table td {
            padding: 0.75rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.04);
            font-size: 0.9rem; vertical-align: middle;
        }
        .admin-table tr:hover td { background: rgba(255,255,255,0.02); }
        .admin-table img { width: 50px; height: 50px; object-fit: cover; border-radius: 6px; }

        /* Admin Forms */
        .admin-form-card {
            background: #1a1d27; border: 1px solid rgba(255,255,255,0.06);
            border-radius: 12px; padding: 2rem;
        }
        .admin-form-card .form-group { margin-bottom: 1.25rem; }
        .admin-form-card label { display: block; color: #ccc; margin-bottom: 0.4rem; font-size: 0.9rem; font-weight: 500; }
        .admin-form-card input, .admin-form-card select, .admin-form-card textarea {
            width: 100%; padding: 0.6rem 0.9rem; border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px; background: #0f1117; color: #e0e0e0; font-size: 0.9rem;
            outline: none; box-sizing: border-box;
        }
        .admin-form-card input:focus, .admin-form-card select:focus, .admin-form-card textarea:focus {
            border-color: #e53e3e;
        }
        .admin-form-card textarea { min-height: 100px; resize: vertical; }

        /* Admin Buttons */
        .btn-admin { padding: 0.5rem 1rem; border: none; border-radius: 6px; cursor: pointer; font-size: 0.85rem;
                     display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none; transition: 0.2s; }
        .btn-admin-primary { background: #e53e3e; color: #fff; }
        .btn-admin-primary:hover { background: #c53030; }
        .btn-admin-success { background: #48bb78; color: #fff; }
        .btn-admin-success:hover { background: #38a169; }
        .btn-admin-warning { background: #ed8936; color: #fff; }
        .btn-admin-warning:hover { background: #dd6b20; }
        .btn-admin-danger { background: #f56565; color: #fff; }
        .btn-admin-danger:hover { background: #e53e3e; }
        .btn-admin-outline { background: transparent; border: 1px solid rgba(255,255,255,0.15); color: #ccc; }
        .btn-admin-outline:hover { border-color: #e53e3e; color: #e53e3e; }

        .action-btns { display: flex; gap: 0.5rem; }

        /* Status badges */
        .badge { padding: 0.25rem 0.6rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }
        .badge-pending { background: rgba(237,137,54,0.15); color: #ed8936; }
        .badge-confirmed { background: rgba(66,153,225,0.15); color: #4299e1; }
        .badge-shipping { background: rgba(159,122,234,0.15); color: #9f7aea; }
        .badge-delivered { background: rgba(72,187,120,0.15); color: #48bb78; }
        .badge-cancelled { background: rgba(245,101,101,0.15); color: #f56565; }

        /* Category inline form */
        .category-form-inline { display: flex; gap: 0.75rem; margin-bottom: 1.5rem; align-items: flex-end; }
        .category-form-inline .form-group { flex: 1; margin: 0; }
        .category-form-inline input {
            padding: 0.6rem 0.9rem; border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px; background: #0f1117; color: #e0e0e0; font-size: 0.9rem;
            width: 100%; box-sizing: border-box;
        }

        /* Pagination */
        .admin-pagination { display: flex; gap: 0.5rem; justify-content: center; margin-top: 1.5rem; }
        .admin-pagination a {
            padding: 0.4rem 0.8rem; border-radius: 6px; text-decoration: none;
            background: #1a1d27; border: 1px solid rgba(255,255,255,0.06); color: #999;
        }
        .admin-pagination a.active, .admin-pagination a:hover { background: #e53e3e; color: #fff; border-color: #e53e3e; }

        @media (max-width: 768px) {
            .admin-sidebar { transform: translateX(-100%); }
            .admin-sidebar.show { transform: translateX(0); }
            .admin-main { margin-left: 0; }
        }
    </style>
    <%- style %>
</head>
<body>
    <div class="admin-layout">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="admin-sidebar-header">
                <i class='bx bx-store-alt'></i>
                <div>
                    <h2>GearStation</h2>
                    <span>Admin Panel</span>
                </div>
            </div>
            <nav class="admin-nav">
                <div class="admin-nav-section">Tổng quan</div>
                <a href="/admin" class="<%= typeof title !== 'undefined' && title.includes('Dashboard') ? 'active' : '' %>">
                    <i class='bx bxs-dashboard'></i> Dashboard
                </a>

                <div class="admin-nav-section">Quản lý</div>
                <a href="/admin/products" class="<%= typeof title !== 'undefined' && title.includes('sản phẩm') ? 'active' : '' %>">
                    <i class='bx bx-package'></i> Sản phẩm
                </a>
                <a href="/admin/categories" class="<%= typeof title !== 'undefined' && title.includes('danh mục') ? 'active' : '' %>">
                    <i class='bx bx-category'></i> Danh mục
                </a>
                <a href="/admin/orders" class="<%= typeof title !== 'undefined' && title.includes('đơn hàng') ? 'active' : '' %>">
                    <i class='bx bx-receipt'></i> Đơn hàng
                </a>

                <div class="admin-nav-section">Hệ thống</div>
                <a href="/" target="_blank">
                    <i class='bx bx-store'></i> Xem cửa hàng
                </a>
            </nav>
            <div class="admin-sidebar-footer">
                <a href="/auth/logout"><i class='bx bx-log-out'></i> Đăng xuất</a>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="admin-main">
            <div class="admin-topbar">
                <div></div>
                <div class="user-info">
                    <i class='bx bx-user-circle' style="font-size:1.5rem;"></i>
                    <span>Xin chào, <strong><%= typeof user !== 'undefined' && user ? user.username : 'Admin' %></strong></span>
                </div>
            </div>

            <%- body %>
        </div>
    </div>

    <script src="/js/main.js"></script>
    <%- script %>
</body>
</html>
