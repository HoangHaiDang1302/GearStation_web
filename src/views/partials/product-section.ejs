<div class="container">
    <section>
        <div class="section-container">
            <div class="section-header">
                <h2 class="section-title"><%= sectionTitle %> <i class='bx <%= sectionIcon %> text-primary'></i></h2>
                <a href="<%= sectionLink %>" class="view-all">Xem tất cả</a>
            </div>
            <div class="product-grid">
                <% if (typeof products !== 'undefined' && products.length > 0) { %>
                    <% products.forEach(product => { %>
                    <div class="product-card">
                        <% if (product.is_featured) { %><div class="product-badge">HOT</div><% } %>
                        <a href="/products/<%= product.slug %>" class="product-img-wrap">
                            <% if (product.image) { %>
                                <img src="<%= product.image %>" alt="<%= product.name %>" style="width: 100%; height: 100%; object-fit: cover; position: absolute; top:0; left:0;">
                            <% } else { %>
                                <div class="product-img-placeholder"><i class='bx bx-image-alt'></i></div>
                            <% } %>
                        </a>
                        <div class="product-info">
                            <h3><a href="/products/<%= product.slug %>" title="<%= product.name %>"><%= product.name %></a></h3>
                            <div class="product-price-box">
                                <% if (product.sale_price) { %>
                                    <span class="price"><%= formatCurrency(product.sale_price) %></span>
                                    <span class="price-old"><%= formatCurrency(product.price) %></span>
                                <% } else { %>
                                    <span class="price"><%= product.price ? formatCurrency(product.price) : 'Liên hệ' %></span>
                                <% } %>
                            </div>
                            <form action="/cart/add" method="POST" class="add-to-cart-form" style="margin:0;">
                                <input type="hidden" name="productId" value="<%= product.id %>">
                                <input type="hidden" name="quantity" value="1">
                                <button type="submit" class="btn-buy-now"><i class='bx bx-cart'></i> Thêm vào giỏ</button>
                            </form>
                        </div>
                    </div>
                    <% }) %>
                <% } else { %>
                    <p style="color: var(--text-muted);">Đang cập nhật sản phẩm...</p>
                <% } %>
            </div>
        </div>
    </section>
</div>
