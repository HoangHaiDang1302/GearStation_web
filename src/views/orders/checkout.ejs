<div class="breadcrumb">
    <div class="container">
        <a href="/">Trang chủ</a>
        <i class='bx bx-chevron-right'></i>
        <a href="/cart">Giỏ hàng</a>
        <i class='bx bx-chevron-right'></i>
        <span>Thanh toán</span>
    </div>
</div>

<div class="container">
    <div class="checkout-wrapper">
        <!-- Cột form thông tin giao hàng -->
        <div class="checkout-form-container">
            <h2><i class='bx bx-map-pin text-primary'></i> Thông tin giao hàng</h2>
            <form action="/orders/checkout" method="POST" id="checkoutForm">
                
                <div class="form-group">
                    <label>Họ và tên người nhận <span class="text-primary">*</span></label>
                    <input type="text" name="shipping_name" class="form-control" required placeholder="Nhập họ và tên..." value="<%= user ? user.username : '' %>">
                </div>
                
                <div class="form-group">
                    <label>Số điện thoại <span class="text-primary">*</span></label>
                    <input type="tel" name="shipping_phone" class="form-control" required placeholder="Ví dụ: 0912345678">
                </div>
                
                <div class="form-group">
                    <label>Địa chỉ nhận hàng (Chi tiết) <span class="text-primary">*</span></label>
                    <input type="text" name="shipping_address" class="form-control" required placeholder="Số nhà, Đường, Phường/Xã, Quận/Huyện, Tỉnh/TP">
                </div>

                <div class="form-group">
                    <label>Ghi chú đơn hàng (Tùy chọn)</label>
                    <textarea name="note" class="form-control" rows="3" placeholder="Ghi chú thêm về thời gian giao hàng, chỉ dẫn địa chỉ..."></textarea>
                </div>
                
                <div class="payment-method">
                    <h3><i class='bx bx-credit-card text-primary'></i> Phương thức thanh toán</h3>
                    <div class="payment-option selected">
                        <input type="radio" name="payment_method" id="cod" value="cod" checked>
                        <label for="cod">
                            <i class='bx bx-money'></i>
                            Thanh toán tiền mặt khi nhận hàng (COD)
                        </label>
                    </div>
                    <div class="payment-option">
                        <input type="radio" name="payment_method" id="bank" value="bank" disabled>
                        <label for="bank" style="color: #999;">
                            <i class='bx bx-transfer'></i>
                            Chuyển khoản ngân hàng (Đang bảo trì)
                        </label>
                    </div>
                </div>

            </form>
        </div>

        <!-- Cột tóm tắt đơn hàng -->
        <div class="checkout-summary">
            <h3>Tóm tắt đơn hàng</h3>
            <div class="checkout-items">
                <% items.forEach(item => { %>
                    <div class="checkout-item">
                        <div class="checkout-item-img">
                            <% if (item.image) { %>
                                <img src="<%= item.image %>" alt="<%= item.name %>">
                            <% } else { %>
                                <div class="placeholder-img" style="font-size: 1rem;"><i class='bx bx-image-alt'></i></div>
                            <% } %>
                            <span class="checkout-item-qty"><%= item.quantity %></span>
                        </div>
                        <div class="checkout-item-info">
                            <h4><%= item.name %></h4>
                            <div class="price"><%= ((item.sale_price || item.price) * item.quantity).toLocaleString('vi-VN') %> ₫</div>
                        </div>
                    </div>
                <% }) %>
            </div>

            <div class="summary-divider"></div>
            
            <div class="summary-row">
                <span>Tạm tính:</span>
                <span><%= total.toLocaleString('vi-VN') %> ₫</span>
            </div>
            <div class="summary-row">
                <span>Phí vận chuyển:</span>
                <span>Miễn phí</span>
            </div>
            
            <div class="summary-divider"></div>
            
            <div class="summary-row total-row">
                <span>Tổng thanh toán:</span>
                <span class="total-price"><%= total.toLocaleString('vi-VN') %> ₫</span>
            </div>

            <button type="button" class="btn btn-primary btn-place-order" onclick="document.getElementById('checkoutForm').submit();">
                ĐẶT HÀNG NGAY
            </button>
            <a href="/cart" class="back-to-cart"><i class='bx bx-arrow-back'></i> Quay lại giỏ hàng</a>
        </div>
    </div>
</div>
