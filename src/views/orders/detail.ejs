<!-- Breadcrumb -->
<div class="container">
    <div class="breadcrumb">
        <a href="/">Trang chủ</a>
        <i class='bx bx-chevron-right'></i>
        <a href="/orders">Đơn hàng</a>
        <i class='bx bx-chevron-right'></i>
        <span>Đơn hàng #<%= order.id %></span>
    </div>
</div>

<div class="container">
    <div class="page-section">
        <div class="section-header">
            <h1><i class='bx bx-receipt'></i> Chi tiết đơn hàng #<%= order.id %></h1>
        </div>

        <div class="order-detail-grid">
            <!-- Order Info -->
            <div class="order-info-card">
                <h3>Thông tin đơn hàng</h3>
                <div class="info-row">
                    <span class="info-label">Mã đơn:</span>
                    <span class="info-value"><strong>#<%= order.id %></strong></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Ngày đặt:</span>
                    <span class="info-value"><%= new Date(order.created_at).toLocaleString('vi-VN') %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Trạng thái:</span>
                    <span class="info-value">
                        <% const statusMap = {
                            'pending': { text: 'Chờ xác nhận', cls: 'status-pending' },
                            'confirmed': { text: 'Đã xác nhận', cls: 'status-confirmed' },
                            'shipping': { text: 'Đang giao', cls: 'status-shipping' },
                            'delivered': { text: 'Đã giao', cls: 'status-delivered' },
                            'cancelled': { text: 'Đã hủy', cls: 'status-cancelled' }
                        }; %>
                        <span class="status-badge <%= statusMap[order.status]?.cls || '' %>">
                            <%= statusMap[order.status]?.text || order.status %>
                        </span>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Tổng tiền:</span>
                    <span class="info-value text-primary"><strong><%= order.total_amount.toLocaleString('vi-VN') %> ₫</strong></span>
                </div>
            </div>

            <!-- Shipping Info -->
            <div class="order-info-card">
                <h3>Thông tin giao hàng</h3>
                <div class="info-row">
                    <span class="info-label">Người nhận:</span>
                    <span class="info-value"><%= order.shipping_name %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Điện thoại:</span>
                    <span class="info-value"><%= order.shipping_phone %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Địa chỉ:</span>
                    <span class="info-value"><%= order.shipping_address %></span>
                </div>
                <% if (order.note) { %>
                <div class="info-row">
                    <span class="info-label">Ghi chú:</span>
                    <span class="info-value"><%= order.note %></span>
                </div>
                <% } %>
            </div>
        </div>

        <!-- Order Items -->
        <div class="order-items-section">
            <h3>Sản phẩm đã đặt</h3>
            <div class="orders-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Đơn giá</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof items !== 'undefined') { items.forEach(item => { %>
                        <tr>
                            <td><strong><%= item.product_name %></strong></td>
                            <td><%= item.price.toLocaleString('vi-VN') %> ₫</td>
                            <td><%= item.quantity %></td>
                            <td class="text-primary"><strong><%= (item.price * item.quantity).toLocaleString('vi-VN') %> ₫</strong></td>
                        </tr>
                        <% }) } %>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" style="text-align: right;"><strong>Tổng cộng:</strong></td>
                            <td class="text-primary"><strong><%= order.total_amount.toLocaleString('vi-VN') %> ₫</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div style="margin-top: 2rem;">
            <a href="/orders" class="btn btn-outline"><i class='bx bx-arrow-back'></i> Quay lại danh sách</a>
        </div>
    </div>
</div>
