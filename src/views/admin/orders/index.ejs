<div class="admin-header-bar">
    <h1><i class='bx bx-receipt'></i> Quản lý đơn hàng</h1>
</div>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th>Ngày đặt</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            <% if (orders && orders.length > 0) { %>
                <% const statusText = { pending:'Chờ xác nhận', confirmed:'Đã xác nhận', shipping:'Đang giao', delivered:'Đã giao', cancelled:'Đã hủy' }; %>
                <% orders.forEach(order => { %>
                <tr>
                    <td>#<%= order.id %></td>
                    <td><%= order.fullname || order.email || 'Khách hàng' %></td>
                    <td style="color:#e53e3e;font-weight:600;"><%= order.total_amount ? formatCurrency(order.total_amount) : '—' %></td>
                    <td><span class="badge badge-<%= order.status %>"><%= statusText[order.status] || order.status %></span></td>
                    <td><%= new Date(order.created_at).toLocaleString('vi-VN') %></td>
                    <td>
                        <a href="/admin/orders/<%= order.id %>" class="btn-admin btn-admin-outline"><i class='bx bx-show'></i> Xem</a>
                    </td>
                </tr>
                <% }) %>
            <% } else { %>
                <tr><td colspan="6" style="text-align:center;padding:2rem;color:#888;">Chưa có đơn hàng nào.</td></tr>
            <% } %>
        </tbody>
    </table>
</div>

<% if (totalPages && totalPages > 1) { %>
<div class="admin-pagination">
    <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="?page=<%= i %>" class="<%= i === currentPage ? 'active' : '' %>"><%= i %></a>
    <% } %>
</div>
<% } %>
